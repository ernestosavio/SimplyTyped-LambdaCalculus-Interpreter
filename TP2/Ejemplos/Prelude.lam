def I = \x:E. x
def K = \x:E.\y:E.x
def S = \x:E->E->E.\y:E->E.\z:E.(x z) (y z)

-- Combinadores Logicos (Tipos Booleanos sobre E)

-- Tipo Bool abreviado: Nat -> Nat -> Nat

-- True: Devuelve el primer argumento
def bTrue = \x:Nat. \y:Nat. x

-- False: Devuelve el segundo argumento
def bFalse = \x:Nat. \y:Nat. y


-- Not: Invierte el valor booleano
-- Tipo: (Nat -> Nat -> Nat) -> Nat -> Nat -> Nat
def bNot = \b:Nat->Nat->Nat. \x:Nat. \y:Nat. b y x


-- And: Si p es false devuelve p (false), sino evalúa q
def bAnd = \p:Nat->Nat->Nat. \q:Nat->Nat->Nat. \x:Nat. \y:Nat. p (q x y) y

{-

LamTerm AST:
LAbs "p" (FunT EmptyT (FunT EmptyT EmptyT))
         (LAbs "q" (FunT EmptyT (FunT EmptyT EmptyT)) 
                   (LApp (LApp (LVar "p")
                               (LApp (LApp (LVar "q")
                                           (LAbs "x" EmptyT
                                                     (LAbs "y" EmptyT
                                                               (LVar "x"))))
                                     (LAbs "x" EmptyT
                                               (LAbs "y" EmptyT
                                                         (LVar "y")))))
